# ==============================================================================
# Lifestyle Elevators - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or .env.local with real secrets to version control.
# ==============================================================================

# Canonical Public Website URL (used for Open Graph metadata, sitemap, and brochure sharing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verified WhatsApp Business Number in international format without spaces, '+' or dashes.
# Example: 917795551118
# NOTE: As per PRD §1 and §8, do not enable direct quotation submission to an unconfirmed
# number. Set this value only after the business owner confirms which number is active.
NEXT_PUBLIC_WHATSAPP_NUMBER=+917795551118

# Safety Gate for WhatsApp Quotation Submission:
# Set to 'true' only when NEXT_PUBLIC_WHATSAPP_NUMBER has been verified by the company.
# When 'false' or unset, the website displays an informative configuration notice and
# offers alternative direct phone dialing and email contact options.
NEXT_PUBLIC_ENABLE_WHATSAPP_LEADS=false

# ==============================================================================
# Lifestyle Elevators - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env or .env.local with real secrets to version control.
# ==============================================================================

# Canonical Public Website URL (used for Open Graph metadata, sitemap, and brochure sharing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Business Number in international format without spaces, '+' or dashes.
# Example: 917795551118
NEXT_PUBLIC_WHATSAPP_NUMBER=917795551118

# Feature Flag for WhatsApp Quotation Submission:
# Defaults to true. Set to 'false' to disable WhatsApp lead submission and activate fallback options.
NEXT_PUBLIC_ENABLE_WHATSAPP_LEADS=true
